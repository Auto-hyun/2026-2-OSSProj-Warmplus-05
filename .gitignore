/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/src/coverage

# next.js
/src/.next/
/src/out/

# production
/src/build

# misc
.DS_Store
*.pem

