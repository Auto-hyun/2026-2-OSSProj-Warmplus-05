# 이 파일을 .env.local로 복사해서 값을 채우세요 (.env.local은 git에 올라가지 않아요)

# 작곡: sample(미리 넣어 둔 샘플 곡, 기본) | suno(sunoapi.org로 실제 작곡 — 크레딧 필요)
MUSIC_PROVIDER=sample
# sunoapi.org > API Key 페이지에서 발급. 서버에서만 써요
SUNO_API_KEY=

# 커뮤니티 (Supabase > Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 서버 전용 비밀 키(secret key): 완성된 Suno 곡을 저장소(songs 버킷)로 옮길 때 써요. 절대 NEXT_PUBLIC_를 붙이지 마세요
SUPABASE_SECRET_KEY=

# 오목이 대화 (Claude API). 비워 두면 정해진 말로만 답해요. 서버에서만 써요 (NEXT_PUBLIC_ 금지)
ANTHROPIC_API_KEY=
# 오목이 모델 (비워 두면 claude-opus-5, 싸게 쓰려면 claude-haiku-4-5)
OMOK_MODEL=
